{
  "notes": "Kather, 9 classes, no tuning split (test only). Single architecture, so weight statistics are comparable (proposer P2). Review before the first run: the file is frozen into the pool when it starts.",
  "benchmark": "kather",
  "data_root": null,
  "image_size": 96,
  "pool_size": 100,
  "max_draws": 150,
  "select_metric": "auto",
  "amp": true,
  "gate": {"min_balanced_acc_x_chance": 1.5, "max_pred_share_excess": 0.4},
  "augment": {
    "family_geometry": "flip",
    "random_family": {
      "families": ["gauss", "linf", "photometric", "stain"],
      "ranges": {"gauss": [0.05, 0.25], "linf": [0.05, 0.25], "photometric": [0.4, 0.8], "stain": [0.15, 0.35]},
      "identity_prob": 0.25
    }
  },
  "store": {"rejected_predictions": true, "rejected_checkpoints": false},
  "recipe": {
    "arch": {"fixed": "efficientnet_b0"},
    "pretrained": {"fixed": true},
    "augment": {"choice": ["light_geometric", "heavy_all4", "heavy_all3", "random_family"], "weights": [0.5, 0.3, 0.1, 0.1]},
    "optimizer": {"choice": ["adam", "adamw"], "weights": [0.85, 0.15]},
    "lr": {"loguniform": [1e-4, 1e-3]},
    "weight_decay": {"choice": [0.0, 1e-5, 1e-4]},
    "batch_size": {"fixed": 128},
    "epochs": {"choice": [3, 10, 13]},
    "scheduler": {"fixed": "plateau"},
    "sched_patience": {"int_uniform": [2, 4]},
    "sched_factor": {"choice": [0.5, 0.7]},
    "stop_patience": {"int_uniform": [4, 8]},
    "label_smoothing": {"choice": [0.0, 0.05, 0.1]},
    "drop_rate": {"choice": [0.0, 0.1, 0.2]},
    "train_frac": {"fixed": 1.0}
  },
  "refine": {
    "n_parents": 20,
    "children_per_parent": 5,
    "recipe": {
      "augment": {"choice": ["plain", "light_geometric"]},
      "optimizer": {"fixed": "adam"},
      "lr": {"loguniform": [5e-6, 5e-5]},
      "weight_decay": {"fixed": 0.0},
      "batch_size": {"fixed": 128},
      "epochs": {"choice": [1, 2]},
      "scheduler": {"fixed": "none"},
      "sched_patience": {"fixed": 1},
      "sched_factor": {"fixed": 0.5},
      "stop_patience": {"fixed": 2},
      "label_smoothing": {"fixed": 0.0},
      "train_frac": {"fixed": 1.0}
    }
  }
}
