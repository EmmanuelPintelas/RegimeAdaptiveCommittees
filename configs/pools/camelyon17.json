{
  "notes": "Camelyon17, 2 classes, hospitals 1 (tuning) and 2 (test). First independent pool: efficientnet_b0 only, so weight statistics are comparable within the pool (proposer P2); camelyon17_convnext_atto.json (seed 2) and camelyon17_mixed.json (seed 3) complete the backbone plan, as on every benchmark. The refine section builds the shared-ancestry pool from this pool's members. Review before the first run: the file is frozen into the pool when it starts.",
  "benchmark": "camelyon17",
  "data_root": null,
  "image_size": 96,
  "pool_size": 100,
  "max_draws": 150,
  "select_metric": "auto",
  "amp": true,
  "gate": {"min_balanced_acc_x_chance": 1.5, "max_pred_share_excess": 0.4},
  "augment": {
    "family_geometry": "flip",
    "random_family": {
      "families": ["gauss", "linf", "photometric", "stain"],
      "ranges": {"gauss": [0.05, 0.25], "linf": [0.05, 0.25], "photometric": [0.4, 0.8], "stain": [0.15, 0.35]},
      "identity_prob": 0.25
    }
  },
  "store": {"rejected_predictions": true, "rejected_checkpoints": false},
  "recipe": {
    "arch": {"fixed": "efficientnet_b0"},
    "pretrained": {"fixed": true},
    "augment": {"choice": ["light_geometric", "heavy_geometric", "blur", "sharpen", "clahe", "colour", "occlusion", "random_family", "heavy_all3", "heavy_all4"]},
    "optimizer": {"choice": ["adam", "adamw"]},
    "lr": {"loguniform": [1e-5, 1e-3]},
    "weight_decay": {"choice": [1e-5, 1e-4]},
    "batch_size": {"choice": [64, 128]},
    "epochs": {"fixed": 3},
    "scheduler": {"choice": ["plateau", "halve_each_epoch"], "weights": [0.8, 0.2]},
    "sched_patience": {"int_uniform": [1, 5]},
    "sched_factor": {"choice": [0.1, 0.2, 0.3, 0.5, 0.7]},
    "stop_patience": {"int_uniform": [1, 5]},
    "label_smoothing": {"choice": [0.0, 0.05, 0.1]},
    "drop_rate": {"choice": [0.0, 0.1, 0.2]},
    "train_frac": {"fixed": 1.0}
  },
  "refine": {
    "n_parents": 20,
    "children_per_parent": 5,
    "recipe": {
      "augment": {"choice": ["plain", "light_geometric"]},
      "optimizer": {"fixed": "adam"},
      "lr": {"loguniform": [5e-6, 5e-5]},
      "weight_decay": {"fixed": 0.0},
      "batch_size": {"fixed": 128},
      "epochs": {"choice": [1, 2]},
      "scheduler": {"fixed": "none"},
      "sched_patience": {"fixed": 1},
      "sched_factor": {"fixed": 0.5},
      "stop_patience": {"fixed": 2},
      "label_smoothing": {"fixed": 0.0},
      "train_frac": {"fixed": 1.0}
    }
  }
}
