{
  "notes": "iWildCam, 182 classes, second independent pool: convnext_atto only (weight statistics comparable within the pool). Everything except the backbone-specific optimisation ranges matches configs/pools/iwildcam.json; the convnext_atto ranges follow the rule used on every benchmark (lr from half the efficientnet lower bound to a third of its upper bound, mostly AdamW, weight decay 1e-4 to 1e-2) and equal its case in iwildcam_mixed.json. Run with --pool-seed 2 --out pools/iwildcam_convnext_atto_seed_2, after --preflight. Frozen into the pool when it starts.",
  "benchmark": "iwildcam",
  "data_root": null,
  "image_size": 96,
  "pool_size": 100,
  "max_draws": 150,
  "select_metric": "auto",
  "amp": true,
  "gate": {"min_balanced_acc_x_chance": 1.5, "max_pred_share_excess": 0.4},
  "augment": {
    "family_geometry": "flip",
    "random_family": {
      "families": ["gauss", "linf", "photometric", "stain"],
      "ranges": {"gauss": [0.05, 0.25], "linf": [0.05, 0.25], "photometric": [0.4, 0.8], "stain": [0.15, 0.35]},
      "identity_prob": 0.25
    }
  },
  "store": {"rejected_predictions": true, "rejected_checkpoints": false},
  "recipe": {
    "arch": {"fixed": "convnext_atto"},
    "pretrained": {"fixed": true},
    "augment": {"choice": ["light_geometric", "heavy_all4", "random_family"], "weights": [0.7, 0.2, 0.1]},
    "optimizer": {"choice": ["adam", "adamw"], "weights": [0.3, 0.7]},
    "lr": {"loguniform": [5e-5, 3.3e-4]},
    "weight_decay": {"choice": [1e-4, 1e-3, 1e-2]},
    "batch_size": {"fixed": 128},
    "epochs": {"choice": [3, 6, 12], "weights": [0.45, 0.35, 0.2]},
    "scheduler": {"choice": ["plateau", "halve_each_epoch"], "weights": [0.8, 0.2]},
    "sched_patience": {"int_uniform": [3, 4]},
    "sched_factor": {"choice": [0.5, 0.7]},
    "stop_patience": {"int_uniform": [5, 6]},
    "label_smoothing": {"choice": [0.0, 0.08], "weights": [0.8, 0.2]},
    "drop_rate": {"choice": [0.0, 0.2], "weights": [0.8, 0.2]},
    "train_frac": {"fixed": 1.0}
  }
}
