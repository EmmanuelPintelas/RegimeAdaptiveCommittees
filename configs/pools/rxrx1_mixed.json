{
  "notes": "RxRx1, 1139 classes, third independent pool: each member draws its backbone from efficientnet_b0, convnext_atto and regnety_004 with equal probability, so committees inside this pool can mix backbone families (collision within versus across backbones). Optimisation ranges and epochs are drawn per backbone: the efficientnet_b0 case equals configs/pools/rxrx1.json and the convnext_atto case equals rxrx1_convnext_atto.json, including its corrected lr range, AdamW and 20 to 40 epochs, so no backbone is trained under a range tuned for another and divergence-driven rejections do not skew the backbone mix. Weight statistics are comparable only within one backbone here. Run with --pool-seed 3 --out pools/rxrx1_mixed_seed_3, after --preflight. Frozen into the pool when it starts.",
  "benchmark": "rxrx1",
  "data_root": null,
  "image_size": 96,
  "pool_size": 100,
  "max_draws": 150,
  "select_metric": "auto",
  "amp": true,
  "gate": {"min_balanced_acc_x_chance": 1.5, "max_pred_share_excess": 0.4},
  "training": {"abandon_patience": 8, "abandon_min_loss_drop": 0.01},
  "augment": {
    "family_geometry": "flip",
    "random_family": {
      "families": ["gauss", "linf", "photometric", "stain"],
      "ranges": {"gauss": [0.05, 0.25], "linf": [0.05, 0.25], "photometric": [0.4, 0.8], "stain": [0.15, 0.35]},
      "identity_prob": 0.25
    }
  },
  "store": {"rejected_predictions": true, "rejected_checkpoints": false},
  "recipe": {
    "arch": {"choice": ["efficientnet_b0", "convnext_atto", "regnety_004"]},
    "pretrained": {"fixed": true},
    "augment": {"choice": ["light_geometric", "heavy_all3", "heavy_all4", "channel_jitter", "heavy_micro"], "weights": [0.5, 0.2, 0.1, 0.1, 0.1]},
    "optimizer": {"by": "arch", "cases": {
      "efficientnet_b0": {"choice": ["adam", "adamw"]},
      "convnext_atto": {"fixed": "adamw"},
      "regnety_004": {"choice": ["adam", "adamw"]}
    }},
    "lr": {"by": "arch", "cases": {
      "efficientnet_b0": {"loguniform": [2e-4, 3e-3]},
      "convnext_atto": {"loguniform": [3e-5, 2.5e-4]},
      "regnety_004": {"loguniform": [2e-4, 2e-3]}
    }},
    "weight_decay": {"by": "arch", "cases": {
      "efficientnet_b0": {"choice": [1e-5, 1e-4]},
      "convnext_atto": {"choice": [1e-4, 1e-3, 1e-2]},
      "regnety_004": {"choice": [1e-5, 1e-4]}
    }},
    "epochs": {"by": "arch", "cases": {
      "efficientnet_b0": {"int_uniform": [15, 35]},
      "convnext_atto": {"int_uniform": [20, 40]},
      "regnety_004": {"int_uniform": [15, 35]}
    }},
    "batch_size": {"choice": [128, 256], "weights": [0.75, 0.25]},
    "scheduler": {"fixed": "plateau"},
    "sched_patience": {"int_uniform": [3, 5]},
    "sched_factor": {"choice": [0.1, 0.2, 0.3, 0.5, 0.7]},
    "stop_patience": {"int_uniform": [5, 9]},
    "label_smoothing": {"choice": [0.0, 0.05, 0.1]},
    "drop_rate": {"choice": [0.0, 0.1, 0.2]},
    "train_frac": {"fixed": 1.0}
  }
}
